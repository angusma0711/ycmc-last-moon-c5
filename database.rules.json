{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".write": "auth != null && $room.matches(/^[a-f0-9]{32}$/) && ((!data.exists() && newData.child('owner').val() === auth.uid) || (data.child('owner').val() === auth.uid && (!newData.exists() || newData.child('owner').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['owner', 'public'])",
        "owner": {
          ".read": "auth != null && data.val() === auth.uid",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "public": {
          ".read": true,
          ".validate": "newData.hasChildren(['n','round','phase','players','timer','guide','roles','updatedAt'])",
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 11"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "phase": {
            ".validate": "newData.isString() && newData.val().matches(/^(setup|night|private|discussion|skills|vote|dayend|ended|debrief)$/)"
          },
          "players": {
            "$i": {
              ".validate": "newData.hasChildren(['id','alive'])",
              "id": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 11"
              },
              "alive": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "history": {
            "$i": {
              ".validate": "newData.hasChildren(['round','type','text'])",
              "round": {
                ".validate": "newData.isNumber()"
              },
              "type": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 500"
              },
              "totals": {
                "$id": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "winner": {
            ".validate": "newData.val() === 'good' || newData.val() === 'wolf'"
          },
          "guide": {
            ".validate": "newData.val() === 'Evidence' || newData.val() === 'Question' || newData.val() === 'Reasoning'"
          },
          "timer": {
            ".validate": "newData.hasChildren(['remaining'])",
            "remaining": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3660"
            },
            "endAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "roles": {
            "$i": {
              ".validate": "newData.hasChildren(['name','description'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "description": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "shield": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 11"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pairings": {
      "$pair": {
        ".read": "auth != null && data.child('owner').val() === auth.uid",
        ".write": "auth != null && $pair.matches(/^[a-f0-9]{32}$/) && ((!data.exists() && newData.child('owner').val() === auth.uid && !newData.child('claim').exists()) || (data.child('owner').val() === auth.uid && (!newData.exists() || (newData.child('owner').val() === auth.uid && newData.child('key').val() === data.child('key').val() && newData.child('createdAt').val() === data.child('createdAt').val()))))",
        ".validate": "newData.hasChildren(['owner','key','n','createdAt'])",
        "owner": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "key": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 8 && newData.val() <= 11"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val()) && newData.val() <= now + 60000"
        },
        "claim": {
          ".write": "auth != null && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('key').val() === data.parent().child('key').val() && data.parent().child('owner').exists() && ((!data.exists() && now - data.parent().child('createdAt').val() <= 600000) || data.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid','key'])",
          "uid": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
          },
          "key": {
            ".validate": "newData.val() === newData.parent().parent().child('key').val()"
          },
          "room": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/) && root.child('rooms').child(newData.val()).child('owner').val() === newData.parent().child('uid').val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
